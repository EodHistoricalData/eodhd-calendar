# Required. Get one at https://eodhd.com/register?utm_source=eodhd_oss&utm_medium=app&utm_campaign=calendar&utm_content=env
# Which of the five calendar feeds a key reaches depends on the plan, and
# whatever yours lacks is named on screen in EODHD's own words. A first load
# costs about 90–115 API calls, most of them Screener API pages that rank each
# day's companies, so the free tier's twenty a day does not cover one.
# It stays on this machine and is never sent to the browser.
EODHD_API_KEY=your_api_key_here

# Optional. Enables the AI analysis buttons. Without it every other part of the
# app works and the AI affordances simply do not appear.
# OPENAI_API_KEY=

# Optional. Any OpenAI-compatible endpoint works — Groq, DeepSeek, OpenRouter,
# or a local Ollama at http://localhost:11434/v1.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional. The local port, if 5173 is taken (Vite's default is the same one).
# PORT=5173
